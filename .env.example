# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_long_random_hex_value

# Optional administrator console at /admin.
EEW_ADMIN_USERNAME=replace_with_admin_username
EEW_ADMIN_PASSWORD=replace_with_a_long_unique_password

# Stable node label shown by multi-host Worker management. Use a unique value
# on every physical server or VM; individual Worker IDs are set by Compose.
EEW_QUEUE_NODE_ID=eew-node-1

# Optional: MySQL device database used only for a configured self-hosted Bark.
# EEW_BARK_DEVICE_DSN=user:password@tcp(bark-mysql:3306)/bark
