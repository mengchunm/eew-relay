diff --git a/apns/apns_test.go b/apns/apns_test.go
new file mode 100644
index 0000000..48e48da
--- /dev/null
+++ b/apns/apns_test.go
@@ -0,0 +1,52 @@
+package apns
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/sideshow/apns2/payload"
+)
+
+func TestAddNotificationSound(t *testing.T) {
+	tests := []struct {
+		name      string
+		message   PushMessage
+		wantSound string
+	}{
+		{
+			name:    "passive omits upstream default sound",
+			message: PushMessage{Sound: "1107", ExtParams: map[string]interface{}{"level": "passive"}},
+		},
+		{
+			name:    "empty sound stays omitted",
+			message: PushMessage{ExtParams: map[string]interface{}{"level": "active"}},
+		},
+		{
+			name:      "active keeps configured sound",
+			message:   PushMessage{Sound: "alarm.caf", ExtParams: map[string]interface{}{"level": "active"}},
+			wantSound: "alarm.caf",
+		},
+		{
+			name:      "critical keeps configured sound",
+			message:   PushMessage{Sound: "alarm.caf", ExtParams: map[string]interface{}{"level": "critical"}},
+			wantSound: "alarm.caf",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			built := addNotificationSound(payload.NewPayload(), &tt.message)
+			data, err := json.Marshal(built)
+			if err != nil {
+				t.Fatalf("marshal payload: %v", err)
+			}
+			var body struct {
+				APS map[string]interface{} `json:"aps"`
+			}
+			if err := json.Unmarshal(data, &body); err != nil {
+				t.Fatalf("unmarshal payload: %v", err)
+			}
+			got, present := body.APS["sound"]
+			if tt.wantSound == "" && present {
+				t.Fatalf("sound must be omitted, got %v in %s", got, data)
+			}
+			if tt.wantSound != "" && got != tt.wantSound {
+				t.Fatalf("sound = %v, want %q in %s", got, tt.wantSound, data)
+			}
+		})
+	}
+}
