 	if err != nil {
 		return "", err
 	}
 
+	d.tokensMu.Lock()
+	d.tokens[key] = cachedToken{token: token, expiresAt: time.Now().Add(d.cacheTTL)}
+	d.tokensMu.Unlock()
 	return token, nil
 }
 
