+
+func positiveEnvDuration(name string, fallback time.Duration) time.Duration {
+	raw := strings.TrimSpace(os.Getenv(name))
+	if raw == "" {
+		return fallback
+	}
+	value, err := time.ParseDuration(raw)
+	if err != nil || value <= 0 {
+		logger.Warnf("invalid %s=%q; using %s", name, raw, fallback)
+		return fallback
+	}
+	return value
+}
